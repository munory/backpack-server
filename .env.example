# Copy to .env and fill in. .env is never committed — it holds secrets.

# Database the local Docker container creates (docker-compose.yml).
POSTGRES_USER=backpack
POSTGRES_PASSWORD=change-me
POSTGRES_DB=backpack

# How the server connects to it: postgres://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=postgres://backpack:change-me@localhost:5432/backpack

# Signs access tokens; at least 32 random characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string

# Google sign-in: the *Web application* client id from Google Cloud Console
# (APIs & Services → Credentials). Leave empty to turn Google sign-in off.
GOOGLE_CLIENT_ID=

# Where the server sends email. Locally: Mailpit from docker-compose (read the
# mail at http://localhost:8025). In production: your mail service's SMTP,
# e.g. smtps://user:password@smtp.example.ru:465
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Backpack <no-reply@backpack.local>

# Only on the VPS, where Caddy (https) passes requests on: the address of the
# proxy to trust for the real client address, e.g. 127.0.0.1. Leave empty
# locally — trusting it with no proxy in front lets anyone fake their address.
TRUST_PROXY=

# Where the server listens. Default 127.0.0.1 (this computer only; the Android
# emulator still reaches it as 10.0.2.2). 0.0.0.0 = the home network too, for
# testing on a real phone over Wi-Fi (a VPN on this computer can still block it).
# A phone on USB needs neither: `adb reverse tcp:3000 tcp:3000` lets the app
# reach this computer as localhost:3000.
# HOST=0.0.0.0
