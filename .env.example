# Copy to .env and fill in. .env is never committed — it holds secrets.

# Database the local Docker container creates (docker-compose.yml).
POSTGRES_USER=backpack
POSTGRES_PASSWORD=change-me
POSTGRES_DB=backpack

# How the server connects to it: postgres://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=postgres://backpack:change-me@localhost:5432/backpack

# Signs access tokens; at least 32 random characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string
